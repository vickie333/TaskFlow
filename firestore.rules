rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // A synced deletion marker may be purged once every device has had time to see it.
    // Keep this window in sync with TOMBSTONE_TTL_MS in TaskSynchronizer.kt.
    function expiredTombstone() {
      return resource.data.pendingDelete == true
        && resource.data.updatedAt < (request.time - duration.value(30, 'd')).toMillis();
    }

    // Documents live under their owner's uid. Never allow collection-wide access.
    // Deletions are tombstones so an offline device can learn about them later; only old tombstones can be removed.
    match /users/{userId}/tasks/{taskId} {
      allow read: if owns(userId);
      allow create, update: if owns(userId)
        && request.resource.data.keys().hasOnly(['description', 'isCompleted', 'completed', 'priority', 'updatedAt', 'categoryId', 'pendingDelete'])
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && (('isCompleted' in request.resource.data && request.resource.data.isCompleted is bool)
          || ('completed' in request.resource.data && request.resource.data.completed is bool))
        && request.resource.data.priority in ['ALTA', 'MEDIA', 'BAJA']
        && request.resource.data.updatedAt is int
        && request.resource.data.pendingDelete is bool
        && (!('categoryId' in request.resource.data)
          || request.resource.data.categoryId == null
          || (request.resource.data.categoryId is string
            && request.resource.data.categoryId.size() <= 64
            && exists(/databases/$(database)/documents/users/$(userId)/categories/$(request.resource.data.categoryId))));
      allow delete: if owns(userId) && expiredTombstone();
    }

    match /users/{userId}/categories/{categoryId} {
      allow read: if owns(userId);
      allow create, update: if owns(userId)
        && request.resource.data.keys().hasOnly(['name', 'updatedAt', 'pendingDelete'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.updatedAt is int
        && request.resource.data.pendingDelete is bool;
      allow delete: if owns(userId) && expiredTombstone();
    }
  }
}
